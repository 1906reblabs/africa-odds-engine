# ── AFRICAN BETTING INTELLIGENCE NETWORK ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub. It is in .gitignore.
# Add each value below as a GitHub Secret (Settings → Secrets → Actions).
# ─────────────────────────────────────────────────────────────────────

# ── ADMIN (change the password!) ─────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=your_strong_passphrase_here

# ── TELEGRAM ──────────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather. CHANNEL_ID is your main channel.
# ADMIN_ID is your personal Telegram user ID (get from @userinfobot).
BOT_TOKEN=your_bot_token_here
CHANNEL_ID=-1001234567890
ADMIN_ID=your_telegram_user_id
ADMIN_CHANNEL_ID=-1009876543210

# ── PUBLISH MODE ──────────────────────────────────────────────────────
# 'auto'  = signals post directly to channel
# 'admin' = signals go to review queue first; you approve/reject
PUBLISH_MODE=admin

# ── DATA APIS ─────────────────────────────────────────────────────────
# All free tier. Sign up at the links below.
# the-odds-api.com (500 req/month free)
THE_ODDS_API_KEY=your_odds_api_key

# rapidapi.com → search "API-Football" → subscribe free (100 req/day)
RAPID_API_KEY=your_rapidapi_key

# football-data.org (free tier)
FOOTBALL_DATA_API_KEY=your_football_data_key

# ── SIGNAL ENGINE ─────────────────────────────────────────────────────
SIGNALS_PER_CYCLE=7
WEEKLY_SIGNAL_CAP=10
MIN_SIGNALS_EXPECTED=7
CONFIDENCE_THRESHOLD=65
HARD_REJECT_BELOW=50

# ── DATA STORAGE ──────────────────────────────────────────────────────
DATA_DIR=./data

# ── EMAIL (MAILGUN) ───────────────────────────────────────────────────
# mailgun.com → free 3,000 emails/month
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.yourdomain.co.za
ADMIN_EMAIL=you@yourdomain.co.za

# ── PAYFAST (SA PAYMENTS) ─────────────────────────────────────────────
# payfast.co.za → register business account
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true
SITE_URL=https://yourdomain.co.za

# ── WHATSAPP (TWILIO — founding members only) ─────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WA_NUMBER=whatsapp:+27xxxxxxxxx

# ── AFFILIATE LINKS (replace with your referral URLs) ────────────────
AFFILIATE_BETWAY=https://betway.co.za
AFFILIATE_HOLLYWOODBETS=https://www.hollywoodbets.net
AFFILIATE_1XBET=https://1xbet.com
INCLUDE_AFFILIATES=false
